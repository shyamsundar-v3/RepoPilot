# OmniRoute — local OpenAI-compatible LLM gateway (npm install -g omniroute)
# Defaults already match a default OmniRoute install; only change these if
# you changed OmniRoute's port or want any non-default key.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=omniroute

# Optional — only needed to clone private GitHub repos.
GITHUB_TOKEN=

# Model routing — "auto" lets OmniRoute pick the best available provider.
# Pin a specific model id here if you want deterministic results.
LLM_MODEL=auto
LLM_MODEL_LITE=auto

# ChromaDB telemetry (leave disabled)
ANONYMIZED_TELEMETRY=False
CHROMA_TELEMETRY=False
